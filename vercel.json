{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/manifest.json",
      "dest": "/site.webmanifest"
    },
    {
      "src": "/_expo/static/js/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}